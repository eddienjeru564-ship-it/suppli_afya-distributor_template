# Public URL of this storefront deploy, used for link previews and share links.
NEXT_PUBLIC_SITE_URL=https://kate.suppliafya.co.ke

# Which storefront "/" shows. Every storefront is also served at /<slug>.
NEXT_PUBLIC_DEFAULT_STOREFRONT=kate

# Optional. The Suppli Afya app this storefront reports to. When set, a customer who sends their
# selector results to the distributor is also saved as a prospect in the distributor's portal
# (POST <url>/api/leads, the same endpoint the health check link uses).
SUPPLI_AFYA_URL=

# Optional. Every order placed on the storefront is POSTed here as JSON (after the server has
# re-priced it). Use it to feed a spreadsheet, a chat channel or the portal once it takes orders.
ORDER_WEBHOOK_URL=
